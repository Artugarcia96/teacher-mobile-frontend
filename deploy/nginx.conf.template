# Sepia web (sepia-cuaderno-web): the landing at "/", the app for every other route and /api proxied to the API.
# The nginx:alpine entrypoint renders this template at start-up, filling in SEPIA_API_UPSTREAM (set by deploy/deploy.sh).
server {
    listen 80;
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 80m;           # scanned exams, photos of textbook pages
    client_body_timeout 300s;

    gzip on;
    gzip_comp_level 5;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Docker DNS, resolved per request: nginx starts (and serves the site) even when the API container is down.
    resolver 127.0.0.11 valid=10s ipv6=off;

    location /api/ {
        set $sepia_api ${SEPIA_API_UPSTREAM};
        proxy_pass $sepia_api;          # no URI part: the request goes as is, /api prefix included
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;   # host:port as the browser sent it (absolute URLs keep :8200)
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_send_timeout 300s;        # big uploads
        proxy_read_timeout 300s;        # AI answers that are not jobs (import units, rewrite, brief) take up to ~80 s
    }

    # Landing
    location = / {
        add_header Cache-Control "no-cache";
        try_files /landing/index.html =404;
    }
    location /landing/ {
        add_header Cache-Control "public, max-age=3600";
        try_files $uri =404;
    }

    # App: bundles with a content hash in their name (Vite: name-XXXXXXXX.ext) are immutable; files copied as they are
    # from public/assets keep their name, so they are only cached for an hour. index.html is never cached, so a deploy
    # is seen at once.
    location ~ "^/assets/.+-[A-Za-z0-9_-]{8}\.[a-z0-9]+$" {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }
    location /assets/ {
        add_header Cache-Control "public, max-age=3600";
        try_files $uri =404;
    }
    location = /index.html {
        add_header Cache-Control "no-store";
    }
    location / {
        try_files $uri /index.html;
    }
}
