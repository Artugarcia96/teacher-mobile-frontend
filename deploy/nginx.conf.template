# Sepia web: static app + landing, and /api proxied to the API container.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 80m;          # scanned exams, photos of textbook pages

    # Landing page at the root; the app lives at /hoy, /clases, /evaluar, /entrar…
    location = / { try_files /landing/index.html =404; }
    location /landing/ { try_files $uri =404; expires 7d; }

    location /api/ {
        proxy_pass ${SEPIA_API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;       # AI jobs start quickly, but uploads of big scans can take a while
        proxy_send_timeout 300s;
    }

    location /assets/ { try_files $uri =404; expires 1y; add_header Cache-Control "public, immutable"; }
    location / { try_files $uri $uri/ /index.html; }
}
