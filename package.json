{
  "name": "sepia-app",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check": "npm run typecheck && npm run check:tokens && npm run lint",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:flows": "playwright test --grep-invert @ai",
    "e2e:ai": "playwright test --grep @ai --project desktop",
    "shots": "SHOTS=1 playwright test",
    "landing:clips": "node e2e/landing-clips.mjs"
  },
  "dependencies": {
    "@capacitor/app": "8.0.1",
    "@capacitor/camera": "^8.0.1",
    "@capacitor/core": "8.1.0",
    "@capacitor/keyboard": "8.0.1",
    "@capacitor/status-bar": "8.0.1",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.90.2",
    "katex": "^0.16.22",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.1.0",
    "@playwright/test": "1.56.1",
    "@testing-library/react": "^16.2.0",
    "@types/katex": "^0.16.7",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "^4.0.1",
    "eslint": "^9.20.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "jsdom": "^22.1.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.24.0",
    "vite": "^5.0.0",
    "vitest": "^0.34.6"
  }
}
